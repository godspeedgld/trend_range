# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== 虚拟环境 / 密钥 =====
.env
.env_*
.venv/
venv/
env/

# ===== 数据缓存与产物（ssquant 运行时生成，勿提交）=====
#
# 例外：data_cache 下的**脚本**入库 —— 异地（换电脑/重建仓库）要能直接跑。
# 这些脚本不含任何凭证：PandaData 读 ~/.pandadata/pandadata.env、
# BigQuant 读 ~/.bigquant，都在仓库外；路径也全部改成相对脚本位置了。
# 数据本体（parquet/duckdb 视图）、_meta.json、_progress.json 仍不入库：
#   前者太大且可由脚本重建，后两者是运行时状态（提交了会让新机器误以为分区已落盘）。
data_cache/**
!data_cache/**/
!data_cache/**/*.py
!data_cache/_hs300_members.json
live_data/
sample_data/
data_export/
*.db
*.db-journal
*.db-wal
*.db-shm

# ===== 回测报告 / 日志 / 可视化产物 =====
results/
backtest_results/
reports/
output/
replication/
*.log

# ===== research-projects：只入库代码/文档/清单/成品报告，中间产物不入库 =====
research-projects/**/*.csv
research-projects/**/*.html
# 例外：分析可视化与回测报告是成品（人看的最终产物），保留（28+35 个，约 58M）
!research-projects/**/result_view.html
!research-projects/**/backtest_report.html
# parquet 全是可从 warehouse + 脚本重生成的中间产物（面板/事件/特征），752M，不入库
research-projects/**/*.parquet

# ===== 实验脚本与产物（本地分析，勿提交）=====
.claude/skills/skill-filter-machine-learning/experiments/

# ===== IDE / OS =====
.vscode/
.idea/
.DS_Store
Thumbs.db
